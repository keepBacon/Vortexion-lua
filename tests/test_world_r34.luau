local failures, checks = {}, 0
local function check(name, cond)
	checks += 1
	if not cond then table.insert(failures, name) end
end

local function makeSignal()
	local conns = {}
	local sig = {}
	function sig:Connect(fn)
		local conn = {connected = true, fn = fn}
		function conn:Disconnect()
			self.connected = false
			for i = #conns, 1, -1 do
				if conns[i] == conn then table.remove(conns, i) end
			end
		end
		table.insert(conns, conn)
		return conn
	end
	function sig:Fire(...)
		local snapshot = {}
		for i = 1, #conns do snapshot[i] = conns[i] end
		for _, conn in ipairs(snapshot) do
			if conn.connected then conn.fn(...) end
		end
	end
	return sig
end

local Obj = {}
Obj.__index = Obj
function Obj.new(className, name)
	return setmetatable({ClassName = className, Name = name or className, Parent = nil, Enabled = true, children = {}}, Obj)
end
function Obj:IsA(className) return self.ClassName == className end
function Obj:FindFirstChild(name)
	for _, child in ipairs(self.children) do
		if child.Name == name then return child end
	end
	return nil
end
function Obj:GetDescendants()
	local out = {}
	local function walk(node)
		for _, child in ipairs(node.children) do
			table.insert(out, child)
			walk(child)
		end
	end
	walk(self)
	return out
end
function Obj:AddChild(child)
	child.Parent = self
	table.insert(self.children, child)
	local node = self
	while node do
		if node.DescendantAdded then node.DescendantAdded:Fire(child) end
		node = node.Parent
	end
	return child
end
function Obj:RemoveChild(child)
	for i = #self.children, 1, -1 do
		if self.children[i] == child then table.remove(self.children, i) end
	end
	child.Parent = nil
end
local function emitter(parent, name, enabled)
	local e = Obj.new("ParticleEmitter", name or "ParticleEmitter")
	e.Enabled = enabled ~= false
	parent:AddChild(e)
	return e
end

